# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
*.lcov

# next.js
/.next/
/out/

# production
/build
/dist

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# environment variables & secrets
.env*
!.env.example
*.pem
*.key
*.cert
*.crt

# user uploads & candidate CVs / audio (Data Privacy)
uploads/
/public/uploads/
*.pdf
*.wav
*.mp3
*.ogg
*.webm
*.m4a

# database & local storage
*.sqlite
*.sqlite3
*.db
*.db-journal

# nix & direnv
.direnv/
result
result-*

# IDE & editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.directory

# OS metadata
.DS_Store
Thumbs.db

# AI agents & local tool caches
.gemini/
.claude/
.cursor/
.windsurf/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
