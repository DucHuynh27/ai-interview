# ==========================================
# AI-INTERVIEW ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
# Model chính. Mặc định trong code là gemini-3.8-flash, nhưng bản flash hay quá
# tải (503) nên môi trường hiện tại đang chạy gemini-3.5-flash-lite.
# GEMINI_MODEL="gemini-3.5-flash-lite"
# Model dự phòng khi model chính lỗi hoặc quá tải (mặc định: gemini-3.5-flash-lite)
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
# Timeout mỗi lần gọi (ms). Google từ chối deadline < 10000 nên code tự kẹp sàn 10s.
# GEMINI_TIMEOUT_MS="25000"
# Số lần thử lại cho mỗi model. Để 1 vì việc đổi model đã do code quyết định —
# SDK mặc định thử 5 lần với backoff tới 60s, từng làm request treo ~4 phút.
# GEMINI_MAX_ATTEMPTS="1"

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Supabase ↔ Vercel integration KHÔNG tạo biến tên DATABASE_URL mà inject
# POSTGRES_PRISMA_URL / POSTGRES_URL; code tự nhận cả ba tên.
# URL direct (cổng 5432) chỉ cần cho `pnpm db:push` / migrate, vì pgbouncer
# không chạy được DDL:
# POSTGRES_URL_NON_POOLING="postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# NextAuth / Authentication (Auth.js v5)
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
