if has nix; then
  use flake
fi

dotenv_if_exists .env.local
dotenv_if_exists .env

# NixOS: Prisma không phát hành engine binary riêng cho nixos.
# Bỏ qua kiểm tra checksum và ép tải engine cho debian-openssl-3.0.x
# (hoạt động tốt nhờ tương thích glibc trên NixOS).
export PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
export PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x

